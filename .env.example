# HTTP port and bind address (0.0.0.0 = reachable from phones/laptops on the same Wi-Fi)
PORT=3000
HOST=0.0.0.0
# Neon Postgres connection string (Neon console → Connect → pooled connection, host contains "-pooler").
# Any PostgreSQL 14+ works, e.g. postgresql://postgres@localhost:5432/campus for a local server.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Max database connections per server process (Vercel functions default to 3)
PG_POOL_MAX=10
# Only for `npm test`: a NON-pooled Postgres URL; tests create and drop a throwaway schema in it
TEST_DATABASE_URL=
# Leave empty locally: generated on first run and stored in data/.jwt-secret. Required in production.
JWT_SECRET=
# Defines "today" and hour-of-day buckets. Empty = server timezone
CAMPUS_TZ=
# true shortens every speed-test phase to ~3 s (demos, e2e)
SPEEDTEST_QUICK=false
# none | ollama (optional rewording of the AI summary; never required)
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LOG_LEVEL=info
